---
/**
 * Una línea de la carta: nombre ····· precio, con su descripción y etiqueta.
 * Se renderiza en el build, así que el cliente no baja JavaScript por esto.
 */
import { formatearPrecio } from "../lib/precio.js";
import { rutaDeAsset } from "../lib/rutas.js";

const { producto, fotos = {} } = Astro.props;

// La columna Foto del Sheet manda; si está vacía, se busca en el mapa
// de src/config.js.
const foto = producto.img || fotos[producto.nombre] || null;

const agotado = producto.etiqueta === "agotado";
const nuevo = producto.etiqueta === "nuevo";

// Los agotados se muestran sin precio, a propósito.
const precio = agotado ? null : formatearPrecio(producto.precio);

// data-producto deja que el refresco en vivo encuentre esta fila después.
---

<li class:list={["item", { agotado, "con-foto": !!foto }]} data-producto={producto.nombre}>
  <div class="item-texto">
    <div class="item-row">
      <span class="item-name">
        {producto.nombre}
        {nuevo && <span class="tag tag-nuevo">Nuevo</span>}
        {agotado && <span class="tag tag-agotado">Agotado</span>}
      </span>

      <span class="item-dots"></span>

      {precio && <span class="item-price">{precio}</span>}
    </div>

    {producto.desc && <p class="item-desc">{producto.desc}</p>}
  </div>

  {foto && (
    <img
      class="item-photo"
      src={rutaDeAsset(import.meta.env.BASE_URL, foto)}
      alt={`${producto.nombre}: ${producto.desc || "plato de la panadería"}`}
      width="88"
      height="88"
      loading="lazy"
      decoding="async"
    />
  )}
</li>
