---
/**
 * Espiga de trigo: el motivo gráfico de la marca.
 *
 * Va en SVG inline, no como imagen: pesa unos pocos bytes, es nítida en
 * cualquier pantalla y hereda el color del texto, así funciona igual en el
 * tema claro y en el oscuro.
 */
---

<svg class="espiga" viewBox="0 0 24 44" aria-hidden="true" focusable="false">
  <!-- tallo -->
  <path d="M12 43V13" />

  <!-- grano superior -->
  <path d="M12 4c1.9 1.7 2.8 3.6 2.8 5.6S13.9 13.3 12 15c-1.9-1.7-2.8-3.4-2.8-5.4S10.1 5.7 12 4Z" />

  <!-- tres pares de granos, abriéndose hacia abajo -->
  <path d="M11.2 14.2c-.4 2.4-1.5 4-3.3 4.9-1.1-2.3-.8-4.3.8-6.1Z" />
  <path d="M12.8 14.2c.4 2.4 1.5 4 3.3 4.9 1.1-2.3.8-4.3-.8-6.1Z" />

  <path d="M11.2 20.4c-.4 2.4-1.5 4-3.3 4.9-1.1-2.3-.8-4.3.8-6.1Z" />
  <path d="M12.8 20.4c.4 2.4 1.5 4 3.3 4.9 1.1-2.3.8-4.3-.8-6.1Z" />

  <path d="M11.2 26.6c-.4 2.4-1.5 4-3.3 4.9-1.1-2.3-.8-4.3.8-6.1Z" />
  <path d="M12.8 26.6c.4 2.4 1.5 4 3.3 4.9 1.1-2.3.8-4.3-.8-6.1Z" />
</svg>
