---
/** Una página de la carta: encabezado de sección + su lista de productos. */
import Producto from "./Producto.astro";
import Espiga from "./Espiga.astro";
import { FOTOS, FOTOS_SECCION } from "../config.js";
import { rutaDeAsset } from "../lib/rutas.js";

const { seccion } = Astro.props;

// El número es el de la SECCIÓN, no el de la página: las dos partes de
// "Desayunos" son ambas la 01. Cuando una sección ocupa varias páginas, el
// encabezado lo dice: "01 · 2/2".
const numero = String(seccion.numeroSeccion ?? 1).padStart(2, "0");

// Imagen de cabecera, solo en la primera página de la sección
const fotoSeccion = seccion.parte === 1 ? FOTOS_SECCION[seccion.titulo] : null;
const kicker =
  seccion.totalPartes > 1
    ? `${numero} · ${seccion.parte}/${seccion.totalPartes}`
    : numero;
---

<div class="menu-page" data-seccion={seccion.titulo}>
  <header class="sec-head">
    <p class="sec-kicker"><Espiga /><span>{kicker}</span></p>
    <h2 class="sec-title">{seccion.titulo}</h2>
    {seccion.subtitulo && <p class="sec-sub">{seccion.subtitulo}</p>}
  </header>

  {fotoSeccion && (
    <figure class="sec-foto">
      <img
        src={rutaDeAsset(import.meta.env.BASE_URL, fotoSeccion)}
        alt={`${seccion.titulo} en Panadería Zahara`}
        width="700"
        height="300"
        loading="lazy"
        decoding="async"
      />
    </figure>
  )}

  <ul class:list={["items", { compacto: seccion.compacta }]}>
    {seccion.productos.map((producto) => (
      <Producto producto={producto} fotos={FOTOS} />
    ))}
  </ul>

  <p class="page-note">Precios en pesos colombianos · IVA incluido</p>
</div>
