---
/* ============================================================================
   LA CARTA

   Acá se decide de dónde salen los datos, y eso pasa EN EL BUILD, no en el
   celular del cliente:

     - Si hay un SHEET_ID configurado, se lee el Google Sheet y los productos
       quedan horneados dentro del HTML.
     - Si no hay, se usan los datos de ejemplo de src/data/menu-respaldo.json.

   Resultado: la carta siempre carga al instante y funciona aunque Google se
   caiga o el cliente tenga mala señal. El refresco "en vivo" que corre en el
   navegador (ver src/scripts/flipbook.js) es un extra encima de esto.
   ========================================================================== */

import Carta from "../layouts/Carta.astro";
import Portada from "../components/Portada.astro";
import Seccion from "../components/Seccion.astro";
import Contraportada from "../components/Contraportada.astro";

import {
  SHEET_ID, SHEET_HOJA, SHEET_GID, NEGOCIO, TIMEOUT_EN_VIVO, BORRADOR,
  MAX_PRODUCTOS_POR_PAGINA, SECCIONES_COMPACTAS, MAX_COMPACTO,
  COMPLETAR_CON_RESPALDO,
} from "../config.js";
import { traerMenu, urlDelSheet } from "../lib/sheet.js";
import { paginarSecciones, nombreDePagina } from "../lib/paginar.js";
import { combinarSecciones } from "../lib/combinar.js";
import respaldo from "../data/menu-respaldo.json";

let menu = respaldo;
let origen = "datos de ejemplo (no hay SHEET_ID configurado)";

if (SHEET_ID) {
  try {
    // En el build sí podemos esperar: nadie está mirando la pantalla.
    menu = await traerMenu(SHEET_ID, SHEET_HOJA, { timeout: 15000, gid: SHEET_GID });
    origen = `Google Sheet (${menu.paginas.length} secciones)`;
  } catch (error) {
    // Decisión a propósito: si hay Sheet configurado pero no se pudo leer,
    // reventamos el build en vez de publicar datos viejos en silencio.
    // Así la versión que ya está publicada se queda como está, que es lo
    // correcto, y nos enteramos del problema.
    throw new Error(
      "No se pudo leer el Google Sheet y por eso se detuvo el build.\n" +
        "  Motivo: " + error.message + "\n" +
        "  URL:    " + urlDelSheet(SHEET_ID, SHEET_HOJA) + "\n" +
        '  Revisa que el Sheet esté compartido como "Cualquier persona con el enlace"\n' +
        "  y que la pestaña se llame exactamente \"" + SHEET_HOJA + "\"."
    );
  }
}

// Mientras al Sheet le falten secciones, se completan con el catálogo
// local para que la maqueta se vea entera. El Sheet siempre manda.
let secciones = menu.paginas;

if (COMPLETAR_CON_RESPALDO) {
  secciones = combinarSecciones(menu.paginas, respaldo.paginas);

  const rellenadas = secciones.filter((s) => s.origen === "respaldo");
  if (rellenadas.length) {
    console.log(
      `[carta] ${rellenadas.length} sección(es) completadas desde el respaldo: ` +
        rellenadas.map((s) => s.titulo).join(", ")
    );
  }
}

console.log(`[carta] Origen de los datos: ${origen}`);

// Las secciones largas se parten en varias páginas, para que el cliente
// pase páginas en vez de hacer scroll.
const sinTildes = (t) =>
  String(t ?? "").trim().toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");

const compactas = new Set(SECCIONES_COMPACTAS.map(sinTildes));

// Se marca cada sección antes de paginar, para que la página sepa cómo
// dibujarse y cuántos renglones le caben.
const seccionesMarcadas = secciones.map((s) => ({
  ...s,
  compacta: compactas.has(sinTildes(s.titulo)),
}));

const paginasDeCarta = paginarSecciones(seccionesMarcadas, (s) =>
  s.compacta ? MAX_COMPACTO : MAX_PRODUCTOS_POR_PAGINA
);

// Orden final: Portada → páginas de carta → Contraportada
const nombresDePagina = [
  "Portada",
  ...paginasDeCarta.map(nombreDePagina),
  "Horario y contacto",
];

const total = nombresDePagina.length;

// Lo que necesita el script del cliente para el refresco en vivo.
// Si no hay Sheet configurado va en null y el refresco ni se intenta.
const configEnVivo = SHEET_ID
  ? { url: urlDelSheet(SHEET_ID, SHEET_HOJA, SHEET_GID), timeout: TIMEOUT_EN_VIVO }
  : null;
---

<Carta
  titulo={`Carta — ${NEGOCIO.nombre}`}
  descripcion="Carta digital de la panadería. Pasa las páginas para ver productos, precios y disponibilidad."
  paginas={nombresDePagina}
  configEnVivo={configEnVivo}
  borrador={BORRADOR}
>
  {nombresDePagina.map((nombre, i) => (
    <article
      class="page"
      role="tabpanel"
      aria-label={`Página ${i + 1} de ${total}: ${nombre}`}
      data-titulo={nombre}
    >
      <div class="face front">
        <div class="face-scroll">
        {i === 0 && (
          <Portada
            negocio={NEGOCIO}
            titulo={NEGOCIO.titulo}
            lema={NEGOCIO.lema}
            foto={NEGOCIO.fotoPortada}
            base={import.meta.env.BASE_URL}
          />
        )}
        {i > 0 && i < total - 1 && (
          <Seccion seccion={paginasDeCarta[i - 1]} />
        )}
        {i === total - 1 && <Contraportada negocio={NEGOCIO} />}
        </div>
        <div class="brillo" aria-hidden="true"></div>
      </div>

      {/* Cara trasera: papel en blanco, es lo que se ve a mitad del giro */}
      <div class="face back">
        <div class="brillo" aria-hidden="true"></div>
      </div>
    </article>
  ))}
</Carta>
